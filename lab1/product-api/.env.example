# Database URL (Mặc định dev dùng SQLite, production dùng PostgreSQL)
DB_URL=sqlite:///dev.db
# DB_URL=postgresql+psycopg://app:devpw@db/appdb

# Flask Secret Key (Tạo bằng secrets.token_urlsafe(32))
SECRET_KEY=dev-secret-key-replace-in-production

# App Config class
APP_CONFIG=product_api.config.DefaultConfig

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
