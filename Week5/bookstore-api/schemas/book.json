{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookstore.example.com/schemas/book.json",
  "title": "Book",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "isbn": { "type": "string", "minLength": 10 },
    "price_vnd": { "type": "integer", "minimum": 0 },
    "stock": { "type": "integer", "minimum": 0 },
    "category": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["id", "name", "slug"],
      "additionalProperties": false
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "title", "isbn", "price_vnd", "stock", "category", "authors"],
  "additionalProperties": false
}
